# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sky_take_out
DB_USERNAME=root
DB_PASSWORD=your_strong_password_here

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DATABASE=10

# JWT 配置（生产环境必须使用强随机密钥，至少32字节）
JWT_ADMIN_SECRET=your-256-bit-secret-key-here-at-least-32-bytes-long-admin
JWT_ADMIN_TTL=7200000
JWT_USER_SECRET=your-256-bit-secret-key-here-at-least-32-bytes-long-user
JWT_USER_TTL=7200000

# 阿里云 OSS 配置
ALIOSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIOSS_ACCESS_KEY_ID=your_access_key_id_here
ALIOSS_ACCESS_KEY_SECRET=your_access_key_secret_here
ALIOSS_BUCKET_NAME=your_bucket_name_here

# 微信支付配置
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here
WECHAT_MCHID=your_merchant_id_here
WECHAT_MCH_SERIAL_NO=your_serial_number_here
WECHAT_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
WECHAT_API_V3_KEY=your_api_v3_key_here
WECHAT_CERT_PATH=/path/to/wechatpay_cert.pem
WECHAT_NOTIFY_URL=https://your-domain.com/notify
WECHAT_REFUND_NOTIFY_URL=https://your-domain.com/refund-notify

# 店铺配置
SHOP_ADDRESS=your_shop_address_here

# 百度地图配置
BAIDU_MAP_AK=your_baidu_map_ak_here
