# JWT Configuration - Production Environment
# Copy this file to .env and set your actual values in production

# Admin JWT Secret Key - MUST be changed in production!
# Generate a strong secret key using: openssl rand -base64 64
JWT_ADMIN_SECRET_KEY=your-super-strong-admin-jwt-secret-key-here-minimum-64-characters

# User JWT Secret Key - MUST be changed in production!
# Generate a strong secret key using: openssl rand -base64 64
JWT_USER_SECRET_KEY=your-super-strong-user-jwt-secret-key-here-minimum-64-characters

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sky_take_out
DB_USERNAME=root
DB_PASSWORD=your-db-password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DATABASE=0

# Aliyun OSS Configuration
ALIOSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIOSS_ACCESS_KEY_ID=your-access-key-id
ALIOSS_ACCESS_KEY_SECRET=your-access-key-secret
ALIOSS_BUCKET_NAME=your-bucket-name

# WeChat Pay Configuration
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
WECHAT_MCH_ID=your-mch-id
WECHAT_MCH_SERIAL_NO=your-mch-serial-no
WECHAT_PRIVATE_KEY_FILE_PATH=your-private-key-file-path.pem
WECHAT_API_V3_KEY=your-api-v3-key
WECHAT_WECHAT_PAY_CERT_FILE_PATH=your-wechatpay-cert-file-path.pem
WECHAT_NOTIFY_URL=https://your-domain.com/pay/notify
WECHAT_REFUND_NOTIFY_URL=https://your-domain.com/pay/refund/notify